# Server
PORT=5000

# Frontend origin(s) allowed by CORS.
# Comma-separate when the deployer app has multiple domains.
CORS_ORIGINS=http://localhost:3000

# Absolute URL used for Stripe redirect URLs (success/cancel/portal).
FRONTEND_URL=http://localhost:3000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/saas-subscription-hub

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Auth
JWT_SECRET=please-change-me

# SMTP (nodemailer) for transactional emails
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=your@email.com
SMTP_PASS=your-password

# YouTube Data API key (optional; used to resolve full playback). Falls back to scraping.
YOUTUBE_API_KEY=